{
  "name": "ares-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter @asst/web --filter @asst/chain-intake run build",
    "dev": "pnpm -r --filter @asst/web --filter @asst/chain-intake run dev",
    "lint": "pnpm -r --filter @asst/web --filter @asst/chain-intake run lint",
    "typecheck": "pnpm -r --filter @asst/web --filter @asst/chain-intake run typecheck",
    "test": "pnpm -r --filter @asst/web --filter @asst/chain-intake run test"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "protobufjs": "^7.6.5",
      "ua-parser-js": "^2.0.10",
      "@babel/core": "^7.29.7"
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
