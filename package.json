{
  "name": "ares-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter @asst/web --filter @asst/chain-intake run build",
    "dev": "pnpm -r --filter @asst/web --filter @asst/chain-intake run dev",
    "lint": "pnpm -r --filter @asst/web --filter @asst/chain-intake run lint",
    "typecheck": "pnpm -r --filter @asst/web --filter @asst/chain-intake run typecheck",
    "test": "pnpm -r --filter @asst/web --filter @asst/chain-intake run test"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "protobufjs": "^7.6.5",
      "ua-parser-js": "^2.0.10",
      "@babel/core": "^7.29.7",
      "shell-quote": "^1.10.0",
      "body-parser": "^2.3.0",
      "postcss": "^8.5.10",
      "ws@^7.0.0": "^7.5.11",
      "ws": "^8.21.0",
      "uuid@^11.0.0": "^11.1.1",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.4",
      "sharp": "^0.35.0",
      "@hono/node-server": "^2.0.10"
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
