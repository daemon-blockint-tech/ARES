# ─────────────────────────────────────────────────────────────
# ASST — root environment template
# Copy this file to `.env.local` (gitignored) and fill in what
# you actually need. Every var is optional unless marked
# REQUIRED. The provider matching your orchestrator model must
# have its key set (Ollama / local: do not need a key).
# ─────────────────────────────────────────────────────────────

# ── Orchestrator model (optional) ────────────────────────────
# Format: <provider>:<model>[@<baseUrl>]
# Examples:
#   google:gemini-2.5-flash            (default)
#   openrouter:nvidia/nemotron-nano-9b-v2:free
#   openai:gpt-4o-mini
#   ollama:llama3.1                    (no key needed)
#   local:mistral-7b@http://localhost:1234/v1
#
# Note: when set via SERVER env this can include `@<baseUrl>`.
# When supplied by a public API caller in JSON, `@<baseUrl>` is
# stripped (audit fix #001).
# ASST_ORCHESTRATOR_MODEL=google:gemini-2.5-flash

# Optional: comma-separated allowlist of provider:model values
# the public /api/chat + /api/scan accept from request bodies.
# Leave unset to accept any well-formed value (without @baseUrl).
# ASST_MODEL_ALLOWLIST=google:gemini-2.5-flash,openai:gpt-4o-mini

# ── LLM provider keys (set only what you use) ────────────────
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Base URLs for OpenAI-compatible / local-model providers
# (leave unset if you're using the providers' defaults)
# OPENAI_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434
# ASST_LOCAL_BASE_URL=http://localhost:1234/v1
# ASST_LOCAL_API_KEY=

# ── Solana on-chain data ─────────────────────────────────────
# Used by assurance-tools/solana-rpc-read and related tools.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_NETWORK=devnet

# Helius (apps/chain-intake, optional Enhanced APIs)
# HELIUS_API_KEY=
# WATCH_ADDRESS=
# WEBHOOK_SHARED_SECRET=                       # Bearer secret for /webhooks/helius (constant-time check)

# Postgres (apps/chain-intake + apps/web)
# DATABASE_URL=postgres://user:password@localhost:5432/asst

# ── Public web auth (apps/web) ───────────────────────────────
# ASST_PUBLIC_HOST=your-domain.example         # SIWS domain shown in challenge (fallback: Host header)
# ASST_SESSION_SECRET=                         # 64-char hex OR ≥32-char string. Required for SIWS.
# ASST_SESSION_TTL_DAYS=30
# ASST_ADMIN_WALLETS=                          # comma-separated base58 pubkeys allowed on /api/admin/*
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Upstash Redis (production nonce store + middleware IP limits)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Automation bypass for dashboard/API scripts (optional). When unset in production,
# /api/chat + /api/scan accept SIWS/anonymous ingress per docs/design/public-web-auth-billing.md.
# ASST_WEB_API_KEY=
#
# Chat load test helper (apps/web): docs/runbooks/load-test-chat.mjs — BASE_URL, CONCURRENCY, DURATION_SEC

# Solana wallet UI (dashboard — Phantom via wallet adapter)
# NEXT_PUBLIC_SOLANA_NETWORK=devnet            # or mainnet-beta
# NEXT_PUBLIC_SOLANA_RPC_URL=

# ── mppx pay-per-request billing (apps/web) ──────────────────
# Replaces the legacy bundle/ledger flow. /api/chat and /api/scan
# return HTTP 402 with a payment Challenge for non-free-tier callers,
# advertising whichever rails are configured below. At least one of
# the four below MUST be set in production.
#
# REQUIRED — HMAC for challenge binding (≥32 chars, ≥64 hex preferred).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MPP_SECRET_KEY=
#
# Tempo stablecoin (lowest fees, only rail that supports `session` intent
# for sub-cent /api/chat throughput).
# ASST_TEMPO_RECIPIENT=                        # 0x-prefixed EVM address (40 hex chars).
# ASST_TEMPO_CURRENCY=0x20c0000000000000000000000000000000000000  # PathUSD (default)
# ASST_TEMPO_TESTNET=true                      # set "false" for mainnet
#
# Optional: enable `tempo/session` (off-chain vouchers) for /api/chat.
# Without this var, only `tempo/charge` is offered (one on-chain tx per request).
# Must be a 0x-prefixed 64-hex private key with signing authority over the
# session channel-close txs. Anvil dev key 0 is shown for testnet only.
# ASST_TEMPO_ACCOUNT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# Stripe cards (Visa, Mastercard, etc.) — supports `charge` only.
# STRIPE_SECRET_KEY=                           # sk_live_... in prod, sk_test_... in dev
#
# Lightning Bitcoin via Spark — supports `charge` only.
# LIGHTNING_MNEMONIC=                          # 12/24-word BIP-39 mnemonic for the receiving wallet
#
# Solana native — supports `charge` only.
# ASST_SOLANA_RECIPIENT=                       # base58 wallet address
# ASST_SOLANA_CURRENCY=                        # SPL mint (omit for native SOL); USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# ASST_SOLANA_DECIMALS=6                       # 6 for USDC, 9 for SOL
# ASST_SOLANA_NETWORK=mainnet-beta             # mainnet-beta | devnet | localnet

# ── Skill retrieval (optional) ───────────────────────────────
# Each sub-agent already bakes 2–3 pinned skills into its system
# prompt. Setting this to N > 0 tells the engine to additionally
# TF-IDF-rank the rest of .agents/skills/ for each invoke() and
# splice the top N matches into the user message. Default: 0 (off).
# Sub-agents can override this per-agent via SubAgentConfig.retrievalTopK.
# ASST_SKILL_RETRIEVAL_TOPK=2

# ── Security / HITL knobs ────────────────────────────────────
# Set ASST_ALLOW_WRITE=0 to force-deny mutating tools everywhere.
# Set ASST_WEB_ALLOW_WRITE=1 on the web server ONLY for trusted
# private deployments (default: disabled).
# ASST_ALLOW_WRITE=1
# ASST_WEB_ALLOW_WRITE=0

# ── Sandbox backend (mutating tools only) ────────────────────
# Every side-effecting tool runs through a SandboxBackend. `host`
# is the default (execa on the operator's machine) and matches
# the legacy behavior. `docker` spins up a throwaway container
# per command with a bind mount; requires Docker Desktop / docker
# on PATH. See packages/engine/src/sandbox/README.md for the
# full backend catalog (incl. deepagents Daytona/Modal adapters).
# ASST_SANDBOX_BACKEND=host                    # host | docker
# ASST_CMD_TIMEOUT=60000                       # ms — per-command
# ASST_CMD_MAX_BYTES=10485760                  # bytes — stdout+stderr cap
# ASST_SANDBOX_DOCKER_IMAGE=alpine:3.20
# ASST_SANDBOX_DOCKER_NETWORK=none             # none | bridge | host
# ASST_SANDBOX_DOCKER_MEMORY=512m
# ASST_SANDBOX_DOCKER_CPUS=1.0

# ── Agent Python service (apps/agent-py) + web proxy ─────────
# Next.js signs POST bodies and forwards chat/scan/history to agent-py.
# AGENT_PY_URL=http://127.0.0.1:8765
# AGENTPY_INTERNAL_SECRET=            # same value as web AGENTPY_INTERNAL_SECRET (HMAC)
# AGENTPY_REDIS_URL=redis://127.0.0.1:6379/0
# AGENTPY_SUPABASE_URL=               # KB-only Supabase project REST URL
# AGENTPY_SUPABASE_SERVICE_ROLE_KEY=
# AGENTPY_EMBEDDING_MODEL=text-embedding-3-small
# AGENTPY_DEFAULT_MODEL=google:gemini-2.5-flash

# ── MCP / Cursor integration (legacy TS MCP server removed) ──
# Use HTTP tools or IDE integration pointed at apps/web /api routes or agent-py directly.

# ── CI / Colosseum Copilot scan (optional) ───────────────────
# COLOSSEUM_COPILOT_PAT=
