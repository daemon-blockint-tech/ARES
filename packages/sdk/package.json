{
  "name": "@ares/sdk",
  "version": "0.1.0",
  "description": "ARES Solana Security Tool — programmatic SDK and `ares` CLI for shells, CI runners, and automation.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ares-system/ares-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ares-system/ares-system.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "ares",
    "solana",
    "security",
    "audit",
    "cli",
    "ci",
    "siws"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ares": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/__tests__/*.test.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
